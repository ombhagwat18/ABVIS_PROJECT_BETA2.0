<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Pipeline" id="pipeline-1">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Multi-project pipeline — create, upload, train, run" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="16" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- on-disk layout -->
        <mxCell id="store" value="projects/&lt;slug&gt;/&#10;&#10;  images/&#10;    +ve/                  good&#10;    -ve/&#10;      Missing cap/        class&#10;      Tilt cap/           class&#10;      Damaged label/      class&#10;    _inbox/               unlabelled&#10;  labels.csv&#10;  config.json      roi, input_wh&#10;  models/&lt;stamp&gt;/  model.pt, metrics.json&#10;  cache/  thumbs/  scenes.json&#10;&#10;Everything a project owns is&#10;under one folder. Nothing is&#10;shared between projects." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Consolas;fontSize=11;spacing=8;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="250" height="330" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Folder position IS the label, so&#10;there is no mapping table to keep&#10;in sync. A new sub-folder under&#10;-ve/ is a new class, no code change.&#10;&#10;_inbox/ sits outside both because a&#10;captured frame has no label yet —&#10;dropping it in +ve/ would teach the&#10;model that anything uninspected is&#10;a good bottle." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacing=8;fillColor=none;strokeColor=#b3b3b3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- stages -->
        <mxCell id="n1" value="1  Create project&#10;name it, e.g. &quot;OM Bottle&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f6f4;strokeColor=#2ec4b6;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="2  Upload&#10;+ve/ = good · -ve/&lt;class&gt;/ = one sub-folder per class" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f6f4;strokeColor=#2ec4b6;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="3  labels.csv written automatically&#10;scan the tree · one column per -ve sub-folder" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f6f4;strokeColor=#2ec4b6;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="4  Set crop&#10;measure or draw ROI + input size" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e8f6f4;strokeColor=#2ec4b6;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="5  Review &amp; label&#10;inbox of unreviewed · fix wrong labels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff4e0;strokeColor=#e8a33d;" vertex="1" parent="1">
          <mxGeometry x="330" y="400" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="6  Train&#10;split by scene · per-defect thresholds" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff4e0;strokeColor=#e8a33d;" vertex="1" parent="1">
          <mxGeometry x="330" y="480" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="7  Per-defect recall good enough?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff4e0;strokeColor=#e8a33d;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="8  Live&#10;camera → crop → verdict + reject log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e6f0fb;strokeColor=#4a90d9;" vertex="1" parent="1">
          <mxGeometry x="330" y="680" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- straight-through edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#666666;verticalAlign=bottom;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- feedback: retrain on better labels -->
        <mxCell id="e8" value="no — relabel the mistakes, add data" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#e8a33d;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=left;" edge="1" parent="1" source="n7" target="n5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="295" y="600" /><mxPoint x="295" y="425" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- feedback: live captures re-enter the dataset -->
        <mxCell id="e9" value="snapshots · low-confidence frames" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#4a90d9;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;align=right;" edge="1" parent="1" source="n8" target="n5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="640" y="705" /><mxPoint x="640" y="425" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="legend" value="solid = one pass through     dashed = the loop you actually live in" style="text;html=1;fontSize=11;fontColor=#777777;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="750" width="400" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
